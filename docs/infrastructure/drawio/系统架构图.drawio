        </mxCell>
        <mxCell id="wQKta3jbfKCP9AP9rwrC-84" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Permission Checker&lt;/h1&gt;&lt;p&gt;主要分为 3 层过滤：&lt;/p&gt;&lt;p&gt;1.&amp;nbsp;&lt;span style=&quot;color: rgb(51, 153, 255); background-color: transparent;&quot;&gt;SessionScopePermissionFilter &lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;（&lt;/span&gt;用于校验该 ToolCall 所属的 Session 是否拥有该 tool 权限&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;）&lt;/span&gt;&lt;/p&gt;&lt;p&gt;2. &lt;span style=&quot;color: rgb(0, 153, 0);&quot;&gt;AgentScopePermissionFilter&lt;/span&gt;（用于校验该 ToolCall 所属的 Agent 是否拥有该 tool 权限）&lt;/p&gt;&lt;p&gt;3.&amp;nbsp;&lt;span style=&quot;color: rgb(255, 51, 51); background-color: transparent;&quot;&gt;ApplicationScopePermissionFilter&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;（&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;根据全局应用层规则初始化权限&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;）&lt;/span&gt;&lt;/p&gt;&lt;p&gt;优先级：session &amp;gt; agent &amp;gt; application&lt;/p&gt;&lt;p&gt;若 ToolCall 的 agent_id / session_id 为空则不进入对应的过滤器。&lt;/p&gt;" vertex="1">
          <mxGeometry height="287.5" width="250" x="1540" y="50" as="geometry" />
        </mxCell>
        <mxCell id="wQKta3jbfKCP9AP9rwrC-85" edge="1" parent="1" source="wQKta3jbfKCP9AP9rwrC-80" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;curved=1;dashed=1;" target="wQKta3jbfKCP9AP9rwrC-84">
