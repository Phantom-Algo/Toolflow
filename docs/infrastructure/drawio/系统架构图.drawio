        <mxCell id="wQKta3jbfKCP9AP9rwrC-106" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;PermissionPolicy&lt;/h1&gt;&lt;p&gt;从作用域的角度：&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;color: rgb(255, 51, 51);&quot;&gt;ApplicationScopeToolPermissionPolicy&lt;/span&gt;：一个 User 对应一个实例&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;color: rgb(0, 153, 0);&quot;&gt;AgentScopeToolPermissionPolicy&lt;/span&gt;：&lt;/p&gt;&lt;p&gt;一个 Agent 对应一个实例&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;color: rgb(0, 127, 255);&quot;&gt;SessionScopeToolPermissionPolicy&lt;/span&gt;：&lt;/p&gt;&lt;p&gt;一个 Session 对应一个实例&lt;/p&gt;" vertex="1">
